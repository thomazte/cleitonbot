# Nome padrão do pacote de figurinhas (quando o usuário não informar)
STICKER_PACK=Cleiton Bot

# Autor padrão das figurinhas
STICKER_AUTHOR=Cleiton

# Pasta de autenticação do Baileys (sessão WhatsApp)
AUTH_DIR=auth_info_baileys

# Pasta de arquivos temporários
TEMP_DIR=temp

# Nível de log: silent | fatal | error | warn | info | debug
LOG_LEVEL=info

# No Windows (caminhos locais). No VPS Ubuntu, deixe comentado se o FFmpeg estiver no PATH.
# FFMPEG_PATH=C:\caminho\para\ffmpeg.exe
# FFPROBE_PATH=C:\caminho\para\ffprobe.exe
