# Nome padrão do pacote de figurinhas (quando o usuário não informar)
STICKER_PACK=Cleiton Bot

# Autor padrão das figurinhas
STICKER_AUTHOR=Cleiton

# Pasta de autenticação do Baileys (sessão WhatsApp)
AUTH_DIR=auth_info_baileys

# Pasta de arquivos temporários
TEMP_DIR=temp

# Nível de log: silent | fatal | error | warn | info | debug
LOG_LEVEL=info

# API oficial do WhatsApp (Cloud API). Não versione os valores reais.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Número do dono. Os comandos privados só existem se estes valores estiverem definidos.
# OWNER_WHATSAPP=
# OWNER_CMD_EXEMPT=
# OWNER_CMD_CHARGE=
# OWNER_CMD_GRANT=
# WEBHOOK_PORT=3000
# WEBHOOK_VERIFY_TOKEN=troque-por-um-segredo-longo

# Só se ffmpeg/ffprobe não estiverem no PATH (ex.: instalação customizada).
# No VPS Ubuntu padrão, deixe comentado.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
